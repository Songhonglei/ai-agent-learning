# Server-only model gateway configuration. Set these values in Vercel Project
# Settings → Environment Variables; never prefix AI_API_KEY with VITE_.
AI_BASE_URL=https://your-model-gateway.example
AI_API_KEY=replace-with-server-only-key
AI_TIMEOUT_MS=20000

# Keep runway-bedrock for Cowork's injected Runway gateway.
# Use openai-chat-completions for OpenAI-compatible APIs and set AI_MODEL.
AI_API_STYLE=openai-chat-completions
AI_MODEL=replace-with-model-name

# Optional. A public, licensed URL to the original source PDF. When omitted,
# source references are rendered as plain text on non-Cowork deployments.
VITE_SOURCE_DOCUMENT_URL=

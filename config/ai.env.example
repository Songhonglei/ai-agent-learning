# Copy this file to config/ai.env and replace the placeholder values.
# It is read only by the local Node.js server and is ignored by Git.
AI_BASE_URL=https://your-model-gateway.example/v1
AI_API_KEY=replace-with-server-only-key
AI_API_STYLE=openai-chat-completions
AI_MODEL=replace-with-model-name
AI_TIMEOUT_MS=20000

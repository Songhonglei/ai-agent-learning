# Copy this file to config/ai.env and replace the placeholder values.
# It is read only by the local Node.js server and is ignored by Git.
AI_BASE_URL=https://your-model-gateway.example/v1
AI_API_KEY=replace-with-server-only-key
AI_API_STYLE=openai-chat-completions
AI_MODEL=replace-with-model-name
AI_TIMEOUT_MS=20000

# Optional fallback; choose any service compatible with the selected API style.
# Enabled only after supplying its key. Primary and fallback may use different services.
AI_FALLBACK_BASE_URL=https://your-fallback-gateway.example/v1
AI_FALLBACK_API_STYLE=openai-chat-completions
AI_FALLBACK_MODEL=replace-with-fallback-model-name
AI_FALLBACK_TIMEOUT_MS=30000
# Only set enabled/disabled if the fallback service supports thinking.type.
AI_FALLBACK_THINKING=
AI_FALLBACK_API_KEY=
